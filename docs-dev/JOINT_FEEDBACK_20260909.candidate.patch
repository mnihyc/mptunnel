+#[tokio::test]
+async fn feedback_pair_common_stream_terminal_and_receiver_drop_release_both_facts() {
+    let ack = Frame::StreamAck {
+        stream_id: StreamId(18),
+        scope_start: None,
+        ranges: vec![OffsetRange { start: 0, end: 8 }],
+    };
+    let (commands, mut receivers) = reliable_path_command_channels(1);
+    commands
+        .try_enqueue_stream_feedback_pair(ack.clone(), 64)
+        .unwrap();
+    commands
+        .send_control(ReliablePathCommand::CloseStream(StreamId(18)))
+        .await
+        .unwrap();
+    let close = recv_reliable_path_command(&mut receivers).await.unwrap();
+    assert!(matches!(
+        close,
+        ReliablePathCommand::CloseStream(StreamId(18))
+    ));
+    receivers.release_pending_command_bytes(reliable_path_command_pending_bytes(&close));
+    assert!(try_recv_reliable_path_command(&mut receivers).is_none());
+    assert_eq!(
+        commands.pending_bytes(),
+        0,
+        "close drops both old facts together"
+    );
+
+    for dequeued in [false, true] {
+        let (commands, mut receivers) = reliable_path_command_channels(1);
+        commands.begin_path_drain();
+        commands
+            .try_enqueue_stream_feedback_pair(ack.clone(), 64)
+            .unwrap();
+        if dequeued {
+            assert!(matches!(
+                try_recv_reliable_path_command(&mut receivers),
+                Some(ReliablePathCommand::SendFeedbackPair(_))
+            ));
+            assert_eq!(commands.writer_pending_bytes(), 2);
+        }
+        assert_eq!(commands.pending_bytes(), 2);
+        drop(receivers);
+        assert_eq!(commands.pending_bytes(), 0);
+        assert_eq!(commands.writer_pending_bytes(), 0);
+        assert!(matches!(
+            commands.try_enqueue_stream_feedback_pair(ack.clone(), 64),
+            Err(crate::runtime::error::RuntimeError::ReliablePathSessionClosed)
+        ));
+        assert_eq!(commands.pending_bytes(), 0);
+    }
+}
