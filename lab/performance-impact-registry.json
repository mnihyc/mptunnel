  "ignored_path_patterns": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "docs/**",
    "**/*_test.rs",
    "lab/test_*.py",
    "lab/PERFORMANCE_DECLARATIONS.md",
    "lab/performance-change.example.json",
    "lab/performance-impact-registry.json",
    "lab/validate_performance_declaration.py"
  ],
  "path_rules": [
    {
      "id": "build-or-dependency",
      "patterns": [
        ".cargo/**",
        ".github/workflows/**",
        "Cargo.lock",
        "Cargo.toml",
        "build.rs",
        "rust-toolchain*",
        "packaging/package-release.*"
      ],
      "required_scopes": [
        "build-or-dependency"
      ]
    },
    {
      "id": "lab-measurement-contract",
      "patterns": [
        "lab/**"
      ],
      "required_scopes": [
        "measurement-contract"
      ]
    },
    {
      "id": "diagnostic-instrumentation",
      "patterns": [
        "src/lab_diagnostics.rs"
      ],
      "required_scopes": [
        "diagnostic-instrumentation"
      ]
    },
    {
      "id": "simulator-evidence",
      "patterns": [
        "src/simulator.rs",
        "src/simulator/**"
      ],
      "required_scopes": [
        "measurement-contract"
      ]
    },
    {
      "id": "performance-envelope",
      "patterns": [
        "src/performance.rs",
        "src/performance_test.rs"
      ],
      "required_scopes": [
        "full-matrix"
      ]
    },
    {
      "id": "wire-protocol",
      "patterns": [
        "src/mux.rs",
        "src/mux/**",
        "src/protocol.rs",
        "src/protocol/**",
        "src/transport/encrypted.rs",
        "src/transport/framed.rs"
      ],
      "required_scopes": [
        "wire-protocol"
      ]
    },
    {
      "id": "quic-datagram-engine",
      "patterns": [
        "src/runtime/datagram/quic.rs",
        "src/runtime/datagram/quic_session.rs",
        "src/runtime/datagram/quic_session/**"
      ],
      "required_scopes": [
        "datagram-engine",
        "quic-carrier"
      ]
    },
    {
      "id": "tcp-datagram-engine",
      "patterns": [
        "src/runtime/datagram/tcp.rs",
        "src/runtime/datagram/tcp_session.rs",
        "src/runtime/datagram/tcp_session/**"
      ],
      "required_scopes": [
        "datagram-engine",
        "tcp-carrier"
      ]
    },
    {
      "id": "datagram-engine",
      "patterns": [
        "src/model/datagram.rs",
        "src/runtime/datagram.rs",
        "src/runtime/datagram/**"
      ],
      "required_scopes": [
        "datagram-engine"
      ]
    },
    {
      "id": "quic-carrier",
      "patterns": [
        "src/transport/quic.rs",
        "src/transport/quic/**",
        "src/transport/udp.rs",
        "crates/quinn-proto/**"
      ],
      "required_scopes": [
        "quic-carrier"
      ]
    },
    {
      "id": "tcp-carrier",
      "patterns": [
        "src/transport/tcp.rs",
        "src/transport/tcp_telemetry.rs",
        "src/transport/tcp_telemetry/**"
      ],
      "required_scopes": [
        "tcp-carrier"
      ]
    },
    {
      "id": "scheduler-and-recovery",
      "patterns": [
        "src/model.rs",
        "src/model/**",
        "src/runtime/path.rs",
        "src/runtime/path/**",
        "src/runtime/relay.rs",
        "src/runtime/relay/**",
        "src/runtime/sender.rs",
        "src/runtime/sender/**",
        "src/runtime/stream.rs",
        "src/runtime/stream/**",
        "src/scheduler.rs",
        "src/scheduler/**"
      ],
      "required_scopes": [
        "scheduler-and-recovery"
      ]
    },
    {
      "id": "resource-accounting",
      "patterns": [
        "src/runtime/recent_ids.rs",
        "src/runtime/identity.rs"
      ],
      "required_scopes": [
        "resource-accounting"
      ]
    },
    {
      "id": "tun-full-stack",
      "patterns": [
        "src/ingress/tun.rs",
        "src/platform/packet_device.rs",
        "src/runtime/tun_l4.rs"
      ],
      "required_scopes": [
        "tun-full-stack"
      ]
    },
    {
      "id": "platform-runtime",
      "patterns": [
        "src/platform.rs",
        "src/platform/**"
      ],
      "required_scopes": [
        "platform-runtime"
      ]
    },
    {
      "id": "product-full-stack",
      "patterns": [
        "config.toml",
        "examples/**",
        "src/app.rs",
        "src/cli.rs",
        "src/config.rs",
        "src/config/**",
        "src/ingress.rs",
        "src/ingress/**",
        "src/outbound.rs",
        "src/outbound/**",
        "src/product.rs",
        "src/product/**",
        "src/runtime/ingress_runtime.rs",
        "src/runtime/management.rs",
        "src/runtime/management/**",
        "src/runtime/node.rs",
        "src/runtime/node/**"
      ],
      "required_scopes": [
        "product-full-stack"
      ]
    },
    {
      "id": "remaining-shipped-source",
      "patterns": [
        "src/**"
      ],
      "required_scopes": [
        "full-matrix"
      ]
    }
  ]
