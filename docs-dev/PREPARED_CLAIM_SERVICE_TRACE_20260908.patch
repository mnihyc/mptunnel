+#[cfg(feature = "lab-diagnostics")]
+fn observe_request_quic_write(
+    send: &UdpPathSendStream,
+    frames: &[Frame],
+    mode: &str,
+    phase: &str,
+    result: &str,
+) {
+    if !crate::lab_diagnostics::lab_diagnostic_event_enabled("request_writer")
+        || std::env::var("MPTUNNEL_LAB_ROLE").as_deref() != Ok("client")
+    {
+        return;
+    }
+    for frame in frames {
+        if let Frame::StreamData {
+            stream_id,
+            offset,
+            payload,
+        } = frame
+        {
+            // H3 identity is connection-local. This shared helper does not
+            // own a runtime path incarnation; completion is local acceptance.
+            crate::lab_diagnostics::lab_diagnostic(
+                "request_writer",
+                format_args!(
+                    "phase={} underlay=Udp mode={} native_request_stream_id={} stream_id={} frame_start={} frame_end={} result={}",
+                    phase,
+                    mode,
+                    send.request_stream_id(),
+                    stream_id.0,
+                    offset,
+                    offset.saturating_add(payload.len() as u64),
+                    result,
+                ),
+            );
+        }
+    }
+}
