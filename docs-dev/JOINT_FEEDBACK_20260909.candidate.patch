+/// Receipt is always publishable here; credit is eligible only after the
+/// existing complete local write/flush future returns success.
+fn publish_client_received_progress(
+    product: &mut RequestProductState,
+    context: &ClientPathContext,
+    recv_stream: &mut ReliableRecvStream,
+    state: &mut ClientRelayState,
+    response_lane: TrafficClass,
+    local_write_completed: bool,
+) -> Result<(), RuntimeError> {
+    let (sender, remotes) = (&mut product.sender, &mut product.remotes);
+    let path = remotes.lowest_eta_path_snapshot(context, response_lane, PATH_OPEN_SCORE_BYTES);
+    let request = if local_write_completed {
+        RelayRecvProgressSend::received_and_consumed(path, response_lane)
+    } else {
+        RelayRecvProgressSend::ack_only(path, response_lane)
+    };
+    match sender.send_recv_progress(
+        remotes,
+        context,
+        recv_stream,
+        &mut state.progress.recv_progress,
+        request,
+    ) {
+        Ok(sent) => state.record_recv_progress_sent(sent),
+        Err(err) if reliable_path_error_is_migratable(&err) => {
+            state.progress.sender_retry_at = None;
+        }
+        Err(err) => return Err(err),
+    }
+    Ok(())
+}
