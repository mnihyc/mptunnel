+async fn commit_request_rate_cohort(
+    sender: &mut crate::runtime::sender::request::RequestSenderService,
+    context: &ClientPathContext,
+    remotes: &mut ReliableRelayRemoteSet,
+    receivers: &mut crate::runtime::path::commands::ReliablePathCommandReceivers,
+    range: OffsetRange,
+) {
+    let stream_id = remotes.stream_id();
+    let quantum = crate::model::capacity::reliable_relay_buffer_len(context.mux_limits);
+    let mut offset = range.start;
+    while offset < range.end {
+        let bytes = quantum.min((range.end - offset) as usize);
+        sender
+            .send_frame(
+                context,
+                remotes,
+                data_frame(stream_id, offset, bytes),
+                RelaySendCause::StreamData,
+                Some(TrafficClass::Throughput),
+            )
+            .await
+            .expect("ordinary planning, exact admission, reservation and Product commit succeed");
+        loop {
+            match try_recv_reliable_path_command(receivers) {
+                Some(ReliablePathCommand::SendFrame(Frame::PathProofData {
+                    path_id,
+                    proof_id,
+                    payload,
+                })) => {
+                    assert_eq!(path_id, PathId(0));
+                    assert_eq!(Some(proof_id), remotes.paths[0].path_proof_id);
+                    assert!(!payload.is_empty());
+                    continue;
+                }
+                Some(ReliablePathCommand::SendFrame(Frame::StreamData {
+                    stream_id: published_stream,
+                    offset: published_offset,
+                    payload,
+                })) => {
+                    assert_eq!(published_stream, stream_id);
+                    assert_eq!(published_offset, offset);
+                    assert_eq!(payload.len(), bytes);
+                    break;
+                }
+                Some(ReliablePathCommand::SendFrame(frame)) => {
+                    panic!("expected committed Product or attachment proof, got {frame:?}")
+                }
+                Some(_) => panic!("unexpected non-frame command"),
+                None => panic!("committed Product frame was not published"),
+            }
+        }
+        // Carrier dequeue releases only writer occupancy, not Product debt.
+        offset += bytes as u64;
+    }
+}
+
+async fn request_rate_refresh_after_real_bootstrap(pipelined: bool) {
+    let stream_id = StreamId(394);
+    let context = client_test_context_with_paths(&["tcp://127.0.0.1:10394?initial-srtt-s=0.1"]);
+    let (commands, mut receivers) = reliable_path_command_channels(8);
+    let mut remotes =
+        ReliableRelayRemoteSet::new(opened_test_relay_stream(stream_id, 0, commands), 8);
+    let owner = remotes.paths[0].instance();
+    consume_client_path_proof_for_test(&mut receivers);
+    context.install_relay_path_instance_for_test(owner);
+    context.mark_tcp_path_open_success(0, Duration::from_millis(100), TrafficClass::Throughput);
+    let mut sender = crate::runtime::sender::request::RequestSenderService::new(stream_id);
+    let floor =
+        request_path_rate_coverage_floor_bytes(UnderlayProtocol::Tcp, None, context.mux_limits);
+    let cohort = |index: u64| OffsetRange {
+        start: index * floor,
+        end: (index + 1) * floor,
+    };
+
+    // Establish qualification and the first numeric sample using actual
+    // accepted OriginalData and exact ACK release, never injected proof flags.
+    commit_request_rate_cohort(
+        &mut sender,
+        &context,
+        &mut remotes,
+        &mut receivers,
+        cohort(0),
+    )
+    .await;
+    assert_eq!(
+        sender
+            .multipath
+            .request
+            .flights
+            .original_data_in_flight_bytes(owner),
+        floor
+    );
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    let bootstrap_ack = Instant::now();
+    sender
+        .multipath
+        .apply_product_ack(&context, &remotes, &[cohort(0)], bootstrap_ack);
+    let state = sender
+        .multipath
+        .request
+        .path_states
+        .get(owner)
+        .expect("actual bootstrap state");
+    assert!(state.product_assignment_qualified());
+    assert!(state.ack_clock_proven());
+    assert!(state.capacity_admitted());
+    let bootstrap_epoch = state.product_rate_epoch().expect("first real sample");
+    assert_eq!(bootstrap_epoch.delivery_samples, 1);
+    assert_eq!(bootstrap_epoch.observed_at, bootstrap_ack);
+    assert!(sender.multipath.request.ack_clock_operation.is_none());
+
+    // The continuous case has two coverage cohorts in flight after bootstrap:
+    // assign A, assign B, ACK A, assign C, ACK B, ACK C. The staged control
+    // instead assigns each new cohort only after the preceding ACK.
+    commit_request_rate_cohort(
+        &mut sender,
+        &context,
+        &mut remotes,
+        &mut receivers,
+        cohort(1),
+    )
+    .await;
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    if pipelined {
+        commit_request_rate_cohort(
+            &mut sender,
+            &context,
+            &mut remotes,
+            &mut receivers,
+            cohort(2),
+        )
+        .await;
+        assert_eq!(
+            sender
+                .multipath
+                .request
+                .flights
+                .original_data_in_flight_bytes(owner),
+            2 * floor
+        );
+    }
+    let mut epochs = Vec::new();
+    let mut ack_times = Vec::new();
+    for index in 1..=3 {
+        tokio::time::sleep(Duration::from_millis(50)).await;
+        let acked_at = Instant::now();
+        let released =
+            sender
+                .multipath
+                .apply_product_ack(&context, &remotes, &[cohort(index)], acked_at);
+        assert_eq!(released.data_ack_progress_paths.as_slice(), &[owner]);
+        let state = sender
+            .multipath
+            .request
+            .path_states
+            .get(owner)
+            .expect("same live owner");
+        assert!(state.product_assignment_qualified());
+        assert!(state.ack_clock_proven());
+        assert!(sender.multipath.request.ack_clock_operation.is_none());
+        epochs.push(
+            state
+                .product_rate_epoch()
+                .expect("retained or refreshed exact epoch"),
+        );
+        ack_times.push(acked_at);
+        if (pipelined && index == 1) || (!pipelined && index < 3) {
+            let next = if pipelined { 3 } else { index + 1 };
+            commit_request_rate_cohort(
+                &mut sender,
+                &context,
+                &mut remotes,
+                &mut receivers,
+                cohort(next),
+            )
+            .await;
+        }
+    }
+    assert_eq!(
+        sender
+            .multipath
+            .request
+            .flights
+            .original_data_in_flight_bytes(owner),
+        0
+    );
+    let replay =
+        sender
+            .multipath
+            .apply_product_ack(&context, &remotes, &[cohort(3)], Instant::now());
+    assert!(replay.data_ack_progress_paths.is_empty());
+    assert_eq!(
+        sender
+            .multipath
+            .request
+            .path_states
+            .get(owner)
+            .unwrap()
+            .product_rate_epoch(),
+        epochs.last().copied()
+    );
+    eprintln!(
+        "pipelined={pipelined} floor={floor} bootstrap_samples={} subsequent_samples={:?} refreshed={:?} final_product_debt=0 acquisition_owner=none",
+        bootstrap_epoch.delivery_samples,
+        epochs
+            .iter()
+            .map(|epoch| epoch.delivery_samples)
+            .collect::<Vec<_>>(),
+        epochs
+            .iter()
+            .zip(&ack_times)
+            .map(|(epoch, at)| epoch.observed_at == *at)
+            .collect::<Vec<_>>(),
+    );
+    for (index, (epoch, acked_at)) in epochs.iter().zip(&ack_times).enumerate() {
+        assert_eq!(
+            epoch.observed_at,
+            *acked_at,
+            "unique admitted cohort {} must refresh request evidence even when its assignment overlaps the previous ACK",
+            index + 1
+        );
+        assert_eq!(epoch.delivery_samples, index as u32 + 2);
+    }
+}
