+// Temporary causal trace: publication, native handoff/read, and Product input
+// are separate observations. This grants no feedback or delivery authority.
+pub(crate) fn lab_stream_ack_stage(
+    stage: &str,
+    stream_id: crate::protocol::StreamId,
+    complete: bool,
+    ranges: &[crate::protocol::OffsetRange],
+    native_id: Option<u64>,
+) {
+    if !lab_diagnostic_event_enabled("stream_ack_stage") {
+        return;
+    }
+    lab_diagnostic("stream_ack_stage", format_args!(
+        "stage={} stream_id={} native_id={:?} complete={} ranges={} first_start={} first_end={} largest_end={}",
+        stage, stream_id.0, native_id, complete, ranges.len(),
+        ranges.first().map_or(0, |r| r.start),
+        ranges.first().map_or(0, |r| r.end),
+        ranges.iter().map(|r| r.end).max().unwrap_or(0),
+    ));
+}
