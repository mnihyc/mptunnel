+#[tokio::test]
+async fn repeated_complete_ack_wire_cost_remains_delta_sized() {
+    use crate::protocol::OffsetRange;
+
+    let frames: Vec<_> = (1u64..=200)
+        .map(|prefix_blocks| {
+            let ranges =
+                std::iter::once(OffsetRange::new(0, (prefix_blocks - 1) * 2000 + 1000).unwrap())
+                    .chain(
+                        (prefix_blocks..200)
+                            .map(|i| OffsetRange::new(i * 2000, i * 2000 + 1000).unwrap()),
+                    )
+                    .collect();
+            Frame::StreamAck {
+                stream_id: StreamId(7),
+                complete: true,
+                ranges,
+            }
+        })
+        .collect();
+    let mut measured = Vec::new();
+    for (name, (client, server)) in [
+        ("TLS", connected_pair(16 * 1024).await),
+        ("Noise", transport_secret_pair(16 * 1024).await),
+    ] {
+        let (_, mut writer) = client.split().unwrap();
+        let (mut reader, _) = server.split().unwrap();
+        let send = async {
+            writer.write_frames(&frames).await.unwrap();
+            writer.flush().await.unwrap();
+            writer.wire_bytes_written()
+        };
+        let receive = async {
+            for frame in &frames {
+                assert_eq!(reader.read_frame().await.unwrap(), *frame);
+            }
+        };
+        let (bytes, ()) = tokio::time::timeout(std::time::Duration::from_secs(5), async {
+            tokio::join!(send, receive)
+        })
+        .await
+        .expect("bounded complete ACK transfer");
+        measured.push((name, bytes));
+    }
+    eprintln!("complete ACK sequence protected wire bytes: {measured:?}");
+    assert!(
+        measured.iter().all(|(_, bytes)| *bytes < 16 * 1024),
+        "repeated snapshot wire cost: {measured:?}"
+    );
+}
