+
+// Prospective response late-placement model, not a violation of the current
+// queue-publication contract or a wall-clock performance claim. Both carriers
+// use the existing protected TCP writer; only their test-driven service order
+// differs. No rate, Native credit, resource limit, or flight state is injected.
+async fn response_pre_native_alternate_case(start_a_writer: bool) {
+    use crate::model::capacity::{
+        adaptive_reliable_relay_chunk_bytes_with_frame_limit,
+        reliable_path_startup_sample_limit_bytes,
+    };
+    use crate::model::path::CarrierPathKey;
+    use crate::mux::{MuxLimits, stream::ReliableSendStream};
+    use crate::runtime::path::commands::reliable_path_command_queue;
+    use crate::runtime::sender::ServerResponseSenderService;
+    use crate::runtime::stream::response::{ResponseStreamAttachOutcome, ResponseStreamBinding};
+    use crate::runtime::stream::{ReliablePathStream, ReliablePathStreamOutput};
+
+    let limits = MuxLimits::default();
+    let lane = TrafficClass::Throughput;
+    let session_id = SessionId(320);
+    let stream_id = StreamId(320);
+    let q = adaptive_reliable_relay_chunk_bytes_with_frame_limit(
+        None,
+        lane,
+        limits,
+        limits.max_payload_bytes,
+    )
+    .min(usize::try_from(reliable_path_startup_sample_limit_bytes(limits)).unwrap());
+    assert!(q > 0);
+    let capacity = reliable_path_command_queue(limits);
+    let (mut a, mut a_peer, a_commands, _a_input, _a_relay) = server_tcp_test_session_with_mode(
+        session_id,
+        PathId(0),
+        crate::config::ForwardingMode::L4,
+        Some(capacity),
+    )
+    .await;
+    let (mut b, mut b_peer, b_commands, _b_input, _b_relay) = server_tcp_test_session_with_mode(
+        session_id,
+        PathId(1),
+        crate::config::ForwardingMode::L4,
+        Some(capacity),
+    )
+    .await;
+    let a_key = CarrierPathKey {
+        underlay: UnderlayProtocol::Tcp,
+        path_id: PathId(0),
+    };
+    let b_key = CarrierPathKey {
+        underlay: UnderlayProtocol::Tcp,
+        path_id: PathId(1),
+    };
+    let binding = ResponseStreamBinding::new_with_limits(
+        session_id,
+        a_key.underlay,
+        a_key.path_id,
+        a_commands.clone(),
+        lane,
+        limits,
+    );
+    // A is a legal sole Backup. Later B's Regular preference makes its actual
+    // admission deterministic without manufacturing completion estimates.
+    let a_target = binding.sender_path_targets(lane, q).remove(0);
+    assert!(binding.update_peer_path_usage_for_test(
+        a_key,
+        a_target.observation.path_instance_id,
+        1,
+        PathUsage::Backup,
+    ));
+    let (_frames_tx, frames) = mpsc::channel(1);
+    let path_stream = ReliablePathStream {
+        stream_id,
+        max_offset: u64::MAX,
+        lane,
+        underlay: UnderlayProtocol::Tcp,
+        max_frame_payload_bytes: limits.max_payload_bytes,
+        output: ReliablePathStreamOutput::Switchable(binding.clone()),
+        frames: frames.into(),
+    };
+    let mut sender = ServerResponseSenderService::new(session_id, stream_id);
+    let mut send_stream = ReliableSendStream::new(stream_id, limits);
+    let payload = Bytes::from(vec![0x5a; q]);
+    for offset in [0, q] {
+        sender.enqueue_data_for_lane(payload.clone(), lane);
+        sender
+            .dispatch_next(&path_stream, &mut send_stream, lane, limits)
+            .expect("publish real response source while A is the sole output");
+        if start_a_writer {
+            let command = try_recv_reliable_path_command(&mut a.commands_rx)
+                .expect("A has its published response command");
+            assert!(matches!(
+                a.drain_commands(command).await.unwrap(),
+                ServerTcpSessionDisposition::Continue
+            ));
+            assert_eq!(
+                a_peer.read_frame().await.unwrap(),
+                Frame::StreamData {
+                    stream_id,
+                    offset: offset as u64,
+                    payload: payload.clone(),
+                }
+            );
+        }
+    }
+    let claimed_before_b = send_stream.next_offset();
+    assert_eq!(
+        sender.data_bytes() as u64 + claimed_before_b,
+        (2 * q) as u64
+    );
+    assert_eq!(send_stream.reinjection_bytes() as u64, claimed_before_b);
+    assert_eq!(a_commands.writer_pending_bytes(), 0);
+
+    assert_eq!(
+        binding.attach(b_key.underlay, b_key.path_id, b_commands.clone(), lane),
+        ResponseStreamAttachOutcome::Attached
+    );
+    let b_target = binding
+        .sender_path_targets(lane, q)
+        .into_iter()
+        .find(|target| target.observation.key == b_key)
+        .unwrap();
+    assert!(b_target.product_admission_active);
+    assert!(!b_target.observation.stale_for_original_data);
+    assert!(b_target.can_enqueue_stream_data(lane));
+    // This same-binding control reaches the real Additional admission check,
+    // command publication, protected write/flush and peer receipt before the
+    // prospective ownership assertion. B is not merely a scored candidate.
+    sender.enqueue_data_for_lane(payload.clone(), lane);
+    let dispatch = sender
+        .dispatch_next(&path_stream, &mut send_stream, lane, limits)
+        .expect("new Regular B has actual Original authority beside A's lower ranges");
+    assert_eq!(dispatch.selected_path, Some(b_key));
+    let command = try_recv_reliable_path_command(&mut b.commands_rx)
+        .expect("B receives its actually admitted Original command");
+    assert!(matches!(
+        b.drain_commands(command).await.unwrap(),
+        ServerTcpSessionDisposition::Continue
+    ));
+    let Frame::StreamData {
+        stream_id: received_stream,
+        offset: b_offset,
+        payload: received,
+    } = b_peer.read_frame().await.unwrap()
+    else {
+        panic!("B must receive response Data")
+    };
+    assert_eq!(received_stream, stream_id);
+    assert_eq!(received, payload);
+    assert_eq!(b_commands.pending_bytes(), 0);
+    assert_eq!(b_commands.writer_pending_bytes(), 0);
+    assert_eq!(
+        sender.data_bytes() as u64 + send_stream.next_offset(),
+        (3 * q) as u64
+    );
+    assert_eq!(
+        send_stream.reinjection_bytes() as u64,
+        send_stream.next_offset()
+    );
+    let targets = binding.sender_path_targets(lane, q);
+    let a_original = targets
+        .iter()
+        .find(|target| target.observation.key == a_key)
+        .unwrap()
+        .observation
+        .original_data_in_flight_bytes;
+    let b_original = targets
+        .iter()
+        .find(|target| target.observation.key == b_key)
+        .unwrap()
+        .observation
+        .original_data_in_flight_bytes;
+    assert_eq!(b_original, q as u64);
+    assert_eq!(a_original + b_original, send_stream.next_offset());
+    if start_a_writer {
+        assert_eq!(claimed_before_b, (2 * q) as u64);
+        assert_eq!(
+            a_original,
+            (2 * q) as u64,
+            "positive native writes remain A's Original ownership until Product ACK"
+        );
+        assert_eq!(b_offset, (2 * q) as u64);
+        assert_eq!(a_commands.pending_bytes(), 0);
+    } else {
+        // A's receiver was never polled. B has already proved real protected
+        // service, so queueing alone must not irrevocably own the lower source.
+        assert_eq!(
+            a_original, 0,
+            "prospective late-placement RED: unconsumed A commands must not own Original bytes while B can write"
+        );
+        assert_eq!(
+            claimed_before_b, 0,
+            "source C must not advance merely to prepare a future A writer command"
+        );
+        assert_eq!(
+            b_offset, 0,
+            "ready B must be able to claim the lowest shared prefix"
+        );
+    }
+}
+
+#[tokio::test]
+async fn response_pre_native_unconsumed_original_remains_available_to_ready_alternate() {
+    response_pre_native_alternate_case(false).await;
+}
+
+#[tokio::test]
+async fn response_pre_native_started_original_retains_its_exact_owner() {
+    response_pre_native_alternate_case(true).await;
+}
