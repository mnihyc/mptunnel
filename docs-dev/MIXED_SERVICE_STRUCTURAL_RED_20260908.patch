+                let _ = release.send(());
+            }
+            if let Some(cancel) = self.cancel_claim.take() {
+                let _ = cancel.send(());
+            }
+            if let Some(claimant) = self.claimant.take() {
+                let _ = claimant.join();
+            }
+            if let Some(relay) = self.relay.take() {
+                relay.abort();
+            }
+        }
+    }
