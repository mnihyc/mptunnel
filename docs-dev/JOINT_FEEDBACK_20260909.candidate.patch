+/// One receipt publication whose ACK and independently due receive grant are
+/// already available together. This is one carrier transaction, not a new wire
+/// frame or permission to combine different ACK generations.
+#[derive(Debug)]
+pub(in crate::runtime) struct ReliableStreamFeedbackPair {
+    frames: [Frame; 2],
+}
+
+impl ReliableStreamFeedbackPair {
+    pub(in crate::runtime) fn new(ack: Frame, max_offset: u64) -> Result<Self, RuntimeError> {
+        let Frame::StreamAck { stream_id, .. } = &ack else {
+            return Err(RuntimeError::Protocol("feedback pair requires STREAM_ACK"));
+        };
+        let max_data = Frame::StreamMaxData {
+            stream_id: *stream_id,
+            max_offset,
+        };
+        Ok(Self {
+            frames: [ack, max_data],
+        })
+    }
+
+    pub(in crate::runtime) fn frames(&self) -> &[Frame; 2] {
+        &self.frames
+    }
+
+    pub(in crate::runtime) fn into_frames(self) -> [Frame; 2] {
+        self.frames
+    }
+
+    pub(in crate::runtime) fn stream_id(&self) -> StreamId {
+        let Frame::StreamAck { stream_id, .. } = &self.frames[0] else {
+            unreachable!("private feedback pair starts with STREAM_ACK");
+        };
+        *stream_id
+    }
+}
+
