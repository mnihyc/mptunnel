+    // Causally unsafe diagnostic ablations, never candidate feedback policies.
+    fn receives_feedback_for_ablation(&self, withheld_kind: &str) -> bool {
+        #[cfg(feature = "lab-diagnostics")]
+        {
+            static SELECTION: std::sync::OnceLock<Option<String>> = std::sync::OnceLock::new();
+            let selection = SELECTION
+                .get_or_init(|| std::env::var("MPTUNNEL_LAB_FEEDBACK_ABLATION").ok())
+                .as_deref();
+            if self.stream.underlay == UnderlayProtocol::Tcp
+                && (selection == Some("quic-only") || selection == Some(withheld_kind))
+            {
+                return false;
+            }
+        }
+        #[cfg(not(feature = "lab-diagnostics"))]
+        let _ = withheld_kind;
+        true
+    }
