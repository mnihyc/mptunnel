+fn feedback_pair_preserves_facts_pressure_and_independent_singleton_admission() {
+    let (commands, mut receivers) = reliable_path_command_channels(1);
+    let ack = Frame::StreamAck {
+        stream_id: StreamId(17),
+        scope_start: Some(2),
+        ranges: vec![OffsetRange { start: 4, end: 8 }],
+    };
+    let max_data = Frame::StreamMaxData {
+        stream_id: StreamId(17),
+        max_offset: 64,
+    };
+    commands
+        .try_enqueue_stream_feedback_pair(ack.clone(), 64)
+        .unwrap();
+    assert_eq!(commands.pending_bytes(), 2);
+    assert!(matches!(
+        commands.try_enqueue_stream_feedback_pair(ack.clone(), 128),
+        Err(crate::runtime::error::RuntimeError::SenderServiceBlocked)
+    ));
+    assert_eq!(
+        commands.pending_bytes(),
+        2,
+        "failed admission owns neither fact"
+    );
+    let command = try_recv_reliable_path_command(&mut receivers).unwrap();
+    assert_eq!(reliable_path_command_pending_bytes(&command), 2);
+    assert_eq!(
+        super::reliable_path_command_writer_run_bytes(&command),
+        crate::protocol::codec::encoded_frame_capacity_hint(&ack)
+            + crate::protocol::codec::encoded_frame_capacity_hint(&max_data)
+    );
+    let ReliablePathCommand::SendFeedbackPair(pair) = command else {
+        panic!("same-publication facts require one typed envelope");
+    };
+    assert_eq!(pair.stream_id(), StreamId(17));
+    assert_eq!(pair.frames(), &[ack.clone(), max_data.clone()]);
+    assert!(try_recv_reliable_path_command(&mut receivers).is_none());
+    assert_eq!(commands.writer_pending_bytes(), 2);
+    receivers.release_pending_command_bytes(2);
+    assert_eq!(commands.pending_bytes(), 0);
+    assert_eq!(commands.writer_pending_bytes(), 0);
+
+    for frame in [ack, max_data] {
+        commands
+            .try_enqueue_stream_ordered_frame(frame.clone(), TrafficClass::Control)
+            .unwrap();
+        let command = try_recv_reliable_path_command(&mut receivers).unwrap();
+        assert!(matches!(&command, ReliablePathCommand::SendFrame(actual) if actual == &frame));
+        receivers.release_pending_command_bytes(reliable_path_command_pending_bytes(&command));
+    }
+    assert!(
+        commands
+            .try_enqueue_stream_feedback_pair(Frame::Ping { nonce: 1 }, 64)
+            .is_err()
+    );
+    assert_eq!(commands.pending_bytes(), 0);
+}
