+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn received_response_service_uncontended_request_planning_control() {
+    assert!(received_response_during_request_planning_case(false).await);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn received_response_service_does_not_wait_for_opposite_request_planning() {
+    assert!(
+        received_response_during_request_planning_case(true).await,
+        "structural isolation contract: ready response service must not depend on releasing an unrelated actual Original planner; the guard duration is not a measured runtime stall",
+    );
+}
