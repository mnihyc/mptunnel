+// Temporary opt-in observation only. No diagnostic timer or recovery authority.
+#[derive(Debug)]
+struct NativeRecoveryTrace {
+    started_at: Instant,
+    last_snapshot_at: Option<Instant>,
+    last_ack: Option<(Instant, SpaceId, u64)>,
+    last_controller_ack_at: Option<Instant>,
+    ack_classes: [u64; 3], // live, retained-only, no-known (not necessarily duplicate)
