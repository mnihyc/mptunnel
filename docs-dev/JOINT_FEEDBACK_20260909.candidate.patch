+#[tokio::test]
+async fn client_recv_progress_joint_publication_preserves_facts_in_one_envelope() {
+    let stream_id = StreamId(923);
+    let context = client_test_context();
+    let (commands, mut receivers) = reliable_path_command_channels(4);
+    let (mut remotes, _remote_input) =
+        ReliableRelayRemoteSet::new(opened_test_relay_stream(stream_id, 0, commands.clone()), 4);
+    consume_client_path_proof_for_test(&mut receivers);
+    assert_eq!(commands.pending_bytes(), 0);
+    let window =
+        reliable_stream_advertised_window_bytes(None, TrafficClass::Throughput, context.mux_limits);
+    let mut recv_stream =
+        ReliableRecvStream::new_with_initial_max_offset(stream_id, context.mux_limits, window);
+    let payload = Bytes::from_static(b"reply");
+    let outcome = recv_stream.receive_data(0, payload.clone()).unwrap();
+    assert_eq!(outcome.delivered.as_slice(), &[payload.clone()]);
+    drop(outcome);
+    let frontier = payload.len() as u64;
+    let expected_grant = window + frontier;
+    let mut progress = ReliableRecvProgress::default();
+    let mut sender = RequestSenderService::new(stream_id);
+
+    assert!(
+        sender
+            .send_recv_progress(
+                &mut remotes,
+                &context,
+                &mut recv_stream,
+                &mut progress,
+                RelayRecvProgressSend::received_and_consumed(None, TrafficClass::Throughput),
+            )
+            .unwrap()
+    );
+    assert_eq!(progress.ack_generation(), 1);
+    assert_eq!(recv_stream.published_max_offset(), expected_grant);
+    assert!(!remotes.has_pending_stream_ack_publication());
+    assert!(!remotes.has_pending_max_data_publication());
+    assert_eq!(commands.pending_bytes(), 2, "two independent control units");
+
+    let mut envelopes = 0;
+    let mut frames = Vec::new();
+    while let Some(command) = try_recv_reliable_path_priority_command(&mut receivers) {
+        envelopes += 1;
+        let charge = reliable_path_command_pending_bytes(&command);
+        match command {
+            ReliablePathCommand::SendFrame(frame) => frames.push(frame),
+            ReliablePathCommand::SendFeedbackPair(pair) => frames.extend(pair.into_frames()),
+            _ => panic!("receive-progress publication contains only feedback"),
+        }
+        receivers.release_pending_command_bytes(charge);
+    }
+    assert_eq!(
+        frames,
+        vec![
+            Frame::StreamAck {
+                stream_id,
+                scope_start: None,
+                ranges: vec![OffsetRange {
+                    start: 0,
+                    end: frontier
+                }],
+            },
+            Frame::StreamMaxData {
+                stream_id,
+                max_offset: expected_grant
+            },
+        ]
+    );
+    assert_eq!(commands.pending_bytes(), 0);
+    let ack_retry = remotes.retry_pending_stream_ack();
+    assert!(!ack_retry.accepted && ack_retry.published && !ack_retry.pending);
+    let max_retry = remotes.retry_pending_max_data();
+    assert_eq!(max_retry.published_offset, None);
+    assert!(!max_retry.pending);
+    assert!(try_recv_reliable_path_priority_command(&mut receivers).is_none());
+
+    // Optimization-work RED: all receipt/credit semantics above already pass.
+    // This bound alone proves neither corruption nor a throughput improvement.
+    assert_eq!(
+        envelopes, 1,
+        "jointly available feedback needs one envelope"
+    );
+}
