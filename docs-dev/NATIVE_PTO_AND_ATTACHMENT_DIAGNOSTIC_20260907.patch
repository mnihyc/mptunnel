+    timeout_counts: [u64; 9],
+    loss_timeouts: u64,
+}
+
+impl NativeRecoveryTrace {
+    fn new(now: Instant) -> Option<Self> {
+        static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        (*ENABLED.get_or_init(|| {
+            std::env::var_os("MPTUNNEL_NATIVE_RECOVERY_TRACE").is_some()
+        }))
+        .then_some(Self {
+            started_at: now,
+            last_snapshot_at: None,
+            last_ack: None,
+            last_controller_ack_at: None,
+            ack_classes: [0; 3],
+            live_packets: 0,
+            retained_packets: 0,
+            controller_live_bytes: 0,
+            timeout_counts: [0; 9],
+            loss_timeouts: 0,
+        })
+    }
+}
