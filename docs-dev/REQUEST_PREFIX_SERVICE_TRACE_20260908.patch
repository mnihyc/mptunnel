+// Temporary request-ingress observation. Queue awaits are wall time, including
+// scheduling; they are not measurements of time exclusively spent Pending.
+pub(crate) struct LabRequestReader {
+    session_id: u64,
+    path_id: u16,
+    path_instance_id: u64,
+    domain: &'static str,
+    interval_start_unix_ms: u128,
+    preceding_nondata_frames: u64,
+    preceding_send_await: Duration,
+    preceding_send_await_max: Duration,
+}
+
+impl LabRequestReader {
+    pub(crate) fn new(
+        session_id: u64,
+        path_id: u16,
+        path_instance_id: u64,
+        domain: &'static str,
+    ) -> Option<Self> {
+        lab_diagnostic_event_enabled("request_reader").then(|| Self {
+            session_id,
+            path_id,
+            path_instance_id,
+            domain,
+            interval_start_unix_ms: SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_millis(),
+            preceding_nondata_frames: 0,
+            preceding_send_await: Duration::ZERO,
+            preceding_send_await_max: Duration::ZERO,
+        })
+    }
+
+    pub(crate) fn decoded(
+        &self,
+        frame: &crate::protocol::Frame,
+        queue_free: Option<usize>,
+    ) -> Option<(u64, u64, u64)> {
+        let crate::protocol::Frame::StreamData {
+            stream_id,
+            offset,
+            payload,
+        } = frame
+        else {
+            return None;
+        };
+        let end = offset.saturating_add(payload.len() as u64);
+        lab_diagnostic(
+            "request_reader",
+            format_args!(
+                "phase=decoded domain={} session_id={} path_id={} path_instance_id={} stream_id={} offset={} end={} queue_free={:?} interval_start_unix_ms={} preceding_nondata_frames={} preceding_send_await_us={} preceding_send_await_max_us={}",
+                self.domain,
+                self.session_id,
+                self.path_id,
+                self.path_instance_id,
+                stream_id.0,
+                offset,
+                end,
+                queue_free,
+                self.interval_start_unix_ms,
+                self.preceding_nondata_frames,
+                self.preceding_send_await.as_micros(),
+                self.preceding_send_await_max.as_micros(),
+            ),
+        );
+        Some((stream_id.0, *offset, end))
+    }
+
+    pub(crate) fn sent(
+        &mut self,
+        data: Option<(u64, u64, u64)>,
+        elapsed: Duration,
+        queue_free: Option<usize>,
+        sent: bool,
+    ) {
+        if let Some((stream_id, offset, end)) = data {
+            lab_diagnostic(
+                "request_reader",
+                format_args!(
+                    "phase=handoff_complete domain={} session_id={} path_id={} path_instance_id={} stream_id={} offset={} end={} send_await_us={} queue_free={:?} sent={}",
+                    self.domain,
+                    self.session_id,
+                    self.path_id,
+                    self.path_instance_id,
+                    stream_id,
+                    offset,
+                    end,
+                    elapsed.as_micros(),
+                    queue_free,
+                    sent,
+                ),
+            );
+            self.interval_start_unix_ms = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_millis();
+            self.preceding_nondata_frames = 0;
+            self.preceding_send_await = Duration::ZERO;
+            self.preceding_send_await_max = Duration::ZERO;
+        } else {
+            self.preceding_nondata_frames += 1;
+            self.preceding_send_await += elapsed;
+            self.preceding_send_await_max = self.preceding_send_await_max.max(elapsed);
+        }
+    }
+}
