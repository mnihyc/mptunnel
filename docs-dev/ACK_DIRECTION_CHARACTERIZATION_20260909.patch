+#[tokio::test]
+async fn client_prewrite_ack_publication_is_independent_of_outbound_rate() {
+    use crate::model::capacity::reliable_stream_ack_update_bytes;
+    use crate::protocol::codec::{CodecLimits, encode_frames};
+
+    fn take_control_frames(
+        receivers: &mut crate::runtime::path::commands::ReliablePathCommandReceivers,
+    ) -> Vec<Frame> {
+        let mut frames = Vec::new();
+        while let Some(command) = try_recv_reliable_path_priority_command(receivers) {
+            receivers.release_pending_command_bytes(reliable_path_command_pending_bytes(&command));
+            let ReliablePathCommand::SendFrame(frame) = command else {
+                panic!("expected a receive-feedback frame");
+            };
+            frames.push(frame);
+        }
+        frames
+    }
+
+    let limits = MuxLimits::default();
+    let low = PathSnapshot::new(PathId(0), UnderlayProtocol::Tcp, 100.0, 351_000.0);
+    let high = PathSnapshot {
+        delivery_rate_bps: 500_000_000.0,
+        ..low
+    };
+    assert_eq!(
+        reliable_stream_ack_update_bytes(Some(low), TrafficClass::Throughput, limits),
+        64 * 1024,
+        "the low legacy outbound scalar is clamped to the default service floor",
+    );
+    assert_eq!(
+        reliable_stream_ack_update_bytes(Some(high), TrafficClass::Throughput, limits),
+        3_125_000,
+        "500 Mbps at 100 ms supplies a 3.125 MB half-BDP before publication policy",
+    );
+
+    // These are received server-to-client bytes. The client DATA branch in
+    // relay/control.rs calls ack_only before the local write, then new(false)
+    // afterward. ack_only forces feedback; the supplied outbound snapshot is
+    // not a receive-rate observation. Change only its legacy delivery scalar,
+    // leaving RTT, pacing, Product/native sidecars, and every DATA boundary fixed.
+    // No sleeps or clock-field mutation: the forced result is independent of
+    // elapsed time, and unchanged postwrite state cannot trigger a new ACK.
+    let incoming = [
+        (0, 1024),
+        (1024, 1024),
+        (65_536, 1024),
+        (65_536, 1024), // Duplicate: forced retry must reuse its generation.
+        (66_560, 1024), // Same-range sparse extension below both byte steps.
+        (2048, 63_488), // Fill the gap and release the already received suffix.
+    ];
+    let generations = [1, 2, 3, 3, 4, 5];
+    let frontiers = [1024, 2048, 2048, 2048, 2048, 67_584];
+    let mut traces = Vec::new();
+    for snapshot in [low, high] {
+        let stream_id = StreamId(922);
+        let context = client_test_context();
+        assert_eq!(context.mux_limits, limits);
+        // A ready exact attachment is drained at each publication boundary;
+        // queue capacity is not an intervention on feedback backpressure.
+        let (commands, mut receivers) = reliable_path_command_channels(4);
+        let (mut remotes, _remote_input) =
+            ReliableRelayRemoteSet::new(opened_test_relay_stream(stream_id, 0, commands), 4);
+        consume_client_path_proof_for_test(&mut receivers);
+        let mut recv_stream = ReliableRecvStream::new(stream_id, limits);
+        let mut progress = ReliableRecvProgress::default();
+        let mut sender = RequestSenderService::new(stream_id);
+        let mut trace = Vec::new();
+        let mut ack_frames = Vec::new();
+        let mut max_frames = Vec::new();
+
+        for (index, (offset, length)) in incoming.into_iter().enumerate() {
+            let previous_frontier = recv_stream.next_offset();
+            recv_stream
+                .receive_data(offset, Bytes::from(vec![0x71; length]))
+                .expect("identical valid response DATA trace");
+            assert_eq!(recv_stream.next_offset(), frontiers[index]);
+            let previous_generation = progress.ack_generation();
+            let previous_credit = recv_stream.published_max_offset();
+            sender
+                .send_recv_progress(
+                    &mut remotes,
+                    &context,
+                    &mut recv_stream,
+                    &mut progress,
+                    RelayRecvProgressSend::ack_only(Some(snapshot), TrafficClass::Throughput),
+                )
+                .expect("actual prewrite ACK publisher");
+            assert_eq!(progress.ack_generation(), generations[index]);
+            assert_eq!(remotes.stream_ack_generation(), generations[index]);
+            assert!(progress.last_ack_at().is_some());
+            assert!(!progress.ack_update_pending());
+            assert!(!remotes.has_pending_stream_ack_publication());
+            assert_eq!(recv_stream.published_max_offset(), previous_credit);
+            let prewrite = take_control_frames(&mut receivers);
+            assert_eq!(
+                prewrite.len(),
+                usize::from(generations[index] > previous_generation),
+                "each changed receipt publishes one ACK; unchanged forced retry publishes none",
+            );
+            assert!(prewrite.iter().all(|frame| matches!(frame, Frame::StreamAck { .. })));
+
+            sender
+                .send_recv_progress(
+                    &mut remotes,
+                    &context,
+                    &mut recv_stream,
+                    &mut progress,
+                    RelayRecvProgressSend::new(Some(snapshot), TrafficClass::Throughput, false),
+                )
+                .expect("actual postwrite feedback publisher");
+            assert_eq!(progress.ack_generation(), generations[index]);
+            assert!(!progress.ack_update_pending());
+            let postwrite = take_control_frames(&mut receivers);
+            let expected_max = if recv_stream.next_offset() > previous_frontier {
+                vec![Frame::StreamMaxData {
+                    stream_id,
+                    max_offset: recv_stream.max_data_offset(),
+                }]
+            } else {
+                Vec::new()
+            };
+            assert_eq!(
+                postwrite, expected_max,
+                "postwrite releases consumed-prefix credit without a second ACK generation",
+            );
+            assert_eq!(recv_stream.published_max_offset(), recv_stream.max_data_offset());
+            ack_frames.extend(prewrite.clone());
+            max_frames.extend(postwrite.clone());
+            trace.push((progress.ack_generation(), prewrite, postwrite));
+        }
+
+        let expected_acks = [
+            (None, 0, 1024),
+            (None, 0, 2048),
+            (Some(2048), 65_536, 66_560),
+            (None, 65_536, 67_584),
+            (None, 0, 67_584),
+        ]
+        .into_iter()
+        .map(|(scope_start, start, end)| Frame::StreamAck {
+            stream_id,
+            scope_start,
+            ranges: vec![OffsetRange { start, end }],
+        })
+        .collect::<Vec<_>>();
+        assert_eq!(ack_frames, expected_acks);
+        assert_eq!(max_frames.len(), 3);
+        let encoded_acks = encode_frames(&ack_frames, CodecLimits::default()).unwrap();
+        let encoded_max = encode_frames(&max_frames, CodecLimits::default()).unwrap();
+        eprintln!(
+            "outbound_rate_bps={} changed_generations=5 ack_frames={} ack_codec_bytes={} max_frames={} max_codec_bytes={}",
+            snapshot.delivery_rate_bps,
+            ack_frames.len(),
+            encoded_acks.len(),
+            max_frames.len(),
+            encoded_max.len(),
+        );
+        traces.push((trace, encoded_acks, encoded_max));
+    }
+    assert_eq!(
+        traces[0], traces[1],
+        "different byte-step arithmetic does not alter this real client prewrite/postwrite publication trace",
+    );
+}
