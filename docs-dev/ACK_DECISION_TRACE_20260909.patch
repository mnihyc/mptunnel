+/// Temporary decision observer; masks describe the unchanged old clock, not a
+/// counterfactual schedule. No frames, identities or receipt ledgers are retained.
+pub(crate) fn lab_ack_decision_totals(
+    now: Instant,
+    bulk: bool,
+    mask: usize,
+    step: u64,
+    path: Option<crate::scheduler::PathSnapshot>,
+) {
+    if !lab_diagnostic_event_enabled("ack_decision_totals") {
+        return;
+    }
+    #[derive(Clone, Copy)]
+    struct Counts {
+        masks: [u64; 64],
+        step_min: u64,
+        step_max: u64,
+        rate_min: f64,
+        rate_max: f64,
+        path_absent: u64,
+    }
+    impl Default for Counts {
+        fn default() -> Self {
+            Self {
+                masks: [0; 64],
+                step_min: u64::MAX,
+                step_max: 0,
+                rate_min: f64::INFINITY,
+                rate_max: 0.0,
+                path_absent: 0,
+            }
+        }
+    }
+    struct State {
+        next_report: Instant,
+        counts: [Counts; 2],
+    }
+    static STATE: OnceLock<Mutex<State>> = OnceLock::new();
+    let mut state = STATE
+        .get_or_init(|| Mutex::new(State {
+            next_report: now + Duration::from_secs(1),
+            counts: [Counts::default(); 2],
+        }))
+        .lock()
+        .expect("lab ACK decision lock");
+    let count = &mut state.counts[usize::from(bulk)];
+    count.masks[mask] += 1;
+    count.step_min = count.step_min.min(step);
+    count.step_max = count.step_max.max(step);
+    if let Some(path) = path {
+        let rate = path.delivery_rate_bps.max(
+            path.product_progress_rate_bps.unwrap_or(path.delivery_rate_bps),
+        );
+        count.rate_min = count.rate_min.min(rate);
+        count.rate_max = count.rate_max.max(rate);
+    } else {
+        count.path_absent += 1;
+    }
+    if now < state.next_report {
+        return;
+    }
+    state.next_report = now + Duration::from_secs(1);
+    for (bulk, count) in state.counts.iter().enumerate() {
+        if count.masks.iter().all(|n| *n == 0) {
+            continue;
+        }
+        let masks = count.masks.iter().map(u64::to_string).collect::<Vec<_>>().join(",");
+        lab_diagnostic(
+            "ack_decision_totals",
+            format_args!(
+                "bulk={} masks={} step_min={} step_max={} rate_min={} rate_max={} path_absent={}",
+                bulk, masks, count.step_min, count.step_max,
+                count.rate_min, count.rate_max, count.path_absent,
+            ),
+        );
+    }
+}
