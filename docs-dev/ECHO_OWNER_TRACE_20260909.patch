+            phase,
+            session_id,
+            stream_id,
+            offset,
+            offset.saturating_add(payload_bytes as u64),
+            state.prepared.response_lane,
+            state.send_stream.next_offset(),
+            state.sender.data_bytes(),
+            model_generation,
+            attempting.key.underlay,
+            attempting.key.path_id.0,
+            attempting.path_instance_id.as_u64(),
+            attempting.incarnation,
+            targets.len(),
+            ready.len(),
+            selected.map(|id| id.key.underlay),
