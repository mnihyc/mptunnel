@@ -1,5 +1,153 @@
 use super::*;
 
+fn complete_ack(id: u64, ranges: &[(u64, u64)]) -> Frame {
+    Frame::StreamAck {
+        stream_id: StreamId(id),
+        complete: true,
+        ranges: ranges
+            .iter()
+            .map(|&(start, end)| OffsetRange::new(start, end).unwrap())
+            .collect(),
+    }
+}
+
+#[test]
+fn ordered_ack_dictionary_preserves_full_snapshots_and_interleaved_context() {
+    let mut encoder = FrameEncoder::default();
+    let mut decoder = FrameDecoder::default();
+    let frames = [
+        complete_ack(1, &[(0, 2), (4, 6), (8, 10)]),
+        complete_ack(1, &[(0, 6), (8, 10)]),
+        Frame::Ping { nonce: 1 },
+        complete_ack(1, &[(0, 6), (8, 10)]),
+        Frame::StreamAck {
+            stream_id: StreamId(2),
+            complete: false,
+            ranges: vec![OffsetRange::new(20, 21).unwrap()],
+        },
+        complete_ack(1, &[(0, 10)]),
+        complete_ack(2, &[(0, 4)]),
+        complete_ack(1, &[(0, 12)]),
+        complete_ack(1, &[(0, 2)]),
+        complete_ack(1, &[(4, 6), (0, 2)]),
+        complete_ack(1, &[(0, 8)]),
+    ];
+    let mut relative_count = 0;
+    for frame in frames {
+        let mut wire = Vec::new();
+        encoder
+            .encode_frame_into(&frame, CodecLimits::default(), &mut wire)
+            .unwrap();
+        assert!(wire.len() <= encode_frame(&frame, CodecLimits::default()).unwrap().len());
+        if matches!(frame, Frame::StreamAck { .. }) && wire[FRAME_HEADER_LEN + 8] & 4 != 0 {
+            relative_count += 1;
+            assert_eq!(
+                decode_frame_bytes(Bytes::from(wire.clone()), CodecLimits::default()),
+                Err(CodecError::InvalidEnum)
+            );
+            assert_eq!(
+                decode_frames_bytes(Bytes::from(wire.clone()), CodecLimits::default()),
+                Err(CodecError::InvalidEnum)
+            );
+        }
+        assert_eq!(
+            decoder
+                .decode_frame_bytes(Bytes::from(wire), CodecLimits::default())
+                .unwrap(),
+            frame
+        );
+    }
+    assert!(relative_count >= 2);
+}
+
+#[test]
+fn discarded_encoder_transaction_resynchronizes_without_knowing_peer_progress() {
+    let initial = complete_ack(1, &[(0, 2), (4, 6), (8, 10)]);
+    let pending = complete_ack(1, &[(0, 6), (8, 10)]);
+    let successor = complete_ack(1, &[(0, 10)]);
+    for peer_consumed_pending in [false, true] {
+        let mut encoder = FrameEncoder::default();
+        let mut decoder = FrameDecoder::default();
+        let mut wire = Vec::new();
+        encoder
+            .encode_frame_into(&initial, CodecLimits::default(), &mut wire)
+            .unwrap();
+        decoder
+            .decode_frame_bytes(Bytes::from(wire), CodecLimits::default())
+            .unwrap();
+        let mut prospective = encoder.clone();
+        let mut pending_wire = Vec::new();
+        prospective
+            .encode_frame_into(&pending, CodecLimits::default(), &mut pending_wire)
+            .unwrap();
+        encoder = FrameEncoder::default(); // before awaited write; no successful commit
+        if peer_consumed_pending {
+            assert_eq!(
+                decoder
+                    .decode_frame_bytes(Bytes::from(pending_wire), CodecLimits::default())
+                    .unwrap(),
+                pending
+            );
+        }
+        let mut successor_wire = Vec::new();
+        encoder
+            .encode_frame_into(&successor, CodecLimits::default(), &mut successor_wire)
+            .unwrap();
+        assert_eq!(successor_wire[FRAME_HEADER_LEN + 8] & 4, 0);
+        assert_eq!(
+            decoder
+                .decode_frame_bytes(Bytes::from(successor_wire), CodecLimits::default())
+                .unwrap(),
+            successor
+        );
+    }
+}
+
+#[test]
+fn relative_ack_rejects_missing_basis_overlap_and_expanded_count_without_mutation() {
+    let initial = complete_ack(1, &[(0, 1), (4, 5)]);
+    let next = complete_ack(1, &[(0, 1), (2, 3), (4, 5)]);
+    let mut encoder = FrameEncoder::default();
+    let mut decoder = FrameDecoder::default();
+    let mut first = Vec::new();
+    encoder
+        .encode_frame_into(&initial, CodecLimits::default(), &mut first)
+        .unwrap();
+    decoder
+        .decode_frame_bytes(Bytes::from(first), CodecLimits::default())
+        .unwrap();
+    let mut second = Vec::new();
+    encoder
+        .encode_frame_into(&next, CodecLimits::default(), &mut second)
+        .unwrap();
+    assert_ne!(second[FRAME_HEADER_LEN + 8] & 4, 0);
+    assert_eq!(
+        FrameDecoder::default()
+            .decode_frame_bytes(Bytes::from(second.clone()), CodecLimits::default()),
+        Err(CodecError::MissingAckBasis)
+    );
+    assert!(matches!(
+        decoder.decode_frame_bytes(
+            Bytes::from(second.clone()),
+            CodecLimits {
+                max_ack_ranges: 2,
+                ..CodecLimits::default()
+            }
+        ),
+        Err(CodecError::TooManyAckRanges { actual: 3, .. })
+    ));
+    assert!(matches!(
+        decoder.decode_frame_bytes(packed_wire(7, 1, &[0, 1]), CodecLimits::default()),
+        Err(CodecError::InvalidRange)
+    ));
+    assert_eq!(
+        decoder
+            .decode_frame_bytes(Bytes::from(second), CodecLimits::default())
+            .unwrap(),
+        next
+    );
+}
