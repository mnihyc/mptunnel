+// This is a structural isolation contract, not a simulated planning-cost or
+// wall-clock performance assertion. The held scope belongs to an actual
+// prepared Original claimant, never to a test-created Product lock holder.
+async fn received_response_during_request_planning_case(pause_plan: bool) -> bool {
+    use crate::model::path::RelayPathInstance;
+    use crate::runtime::path::commands::{
+        reliable_path_command_pending_bytes, reliable_path_command_queue,
+    };
+    use crate::runtime::path::prepared::PreparedOriginalWork;
+    use crate::runtime::sender::RequestPreparedClaim;
+
+    const TEST_GUARD: Duration = Duration::from_secs(5);
+    const HELD_SERVICE_GUARD: Duration = Duration::from_secs(1);
+    const RESPONSE: &[u8] = b"already authenticated reply";
+
+    #[derive(Default)]
+    struct ResponseWriter {
+        bytes: Mutex<Vec<u8>>,
+        flushed: AtomicBool,
+        flush_notify: Notify,
+    }
+
+    struct PreparedSourceAndReadyWriter {
+        source: Bytes,
+        writer: Arc<ResponseWriter>,
+    }
+
+    impl AsyncRead for PreparedSourceAndReadyWriter {
+        fn poll_read(
+            mut self: Pin<&mut Self>,
+            _cx: &mut TaskContext<'_>,
+            buf: &mut ReadBuf<'_>,
+        ) -> Poll<std::io::Result<()>> {
+            if buf.remaining() == 0 {
+                return Poll::Ready(Ok(()));
+            }
+            if self.source.is_empty() {
+                // Keep the request open: FIN and target EOF are not prerequisites
+                // of this independent, already-produced response.
+                return Poll::Pending;
+            }
+            let count = buf.remaining().min(self.source.len());
+            buf.put_slice(&self.source.split_to(count));
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    impl AsyncWrite for PreparedSourceAndReadyWriter {
+        fn poll_write(
+            self: Pin<&mut Self>,
+            _cx: &mut TaskContext<'_>,
+            buf: &[u8],
+        ) -> Poll<std::io::Result<usize>> {
+            self.writer.bytes.lock().unwrap().extend_from_slice(buf);
+            Poll::Ready(Ok(buf.len()))
+        }
+
+        fn poll_flush(
+            self: Pin<&mut Self>,
+            _cx: &mut TaskContext<'_>,
+        ) -> Poll<std::io::Result<()>> {
+            self.writer.flushed.store(true, Ordering::Release);
+            self.writer.flush_notify.notify_one();
+            Poll::Ready(Ok(()))
+        }
+
+        fn poll_shutdown(
+            self: Pin<&mut Self>,
+            _cx: &mut TaskContext<'_>,
+        ) -> Poll<std::io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    type ClaimedWriter = (
