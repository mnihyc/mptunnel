+    use std::future::Future;
+
+    for fail_write in [true, false] {
+        let mut recv_stream = ReliableRecvStream::new(StreamId(702), MuxLimits::default());
+        let mut batch = ReadyStreamDataBatch::new();
+        batch.items.push(());
+        batch.payload_bytes = 5;
+        let applied = apply_ready_stream_data_batch(
+            &mut recv_stream,
+            &mut batch,
+            ReadyStreamDataDirection::ClientDownload,
+            true,
+            |recv_stream, ()| Ok(recv_stream.receive_data(0, Bytes::from_static(b"reply"))?),
+        );
+        let mut writer = VectoredWriteProbe {
+            fail_write,
+            fail_flush: !fail_write,
+            ..VectoredWriteProbe::default()
+        };
+        let result = {
+            let write = write_applied_ready_stream_data_batch(&mut writer, &mut batch, applied);
+            tokio::pin!(write);
+            std::future::poll_fn(|cx| Poll::Ready(write.as_mut().poll(cx))).await
+        };
+        assert!(matches!(result,
+            Poll::Ready(Err(RuntimeError::Io(error)))
+                if error.kind() == std::io::ErrorKind::BrokenPipe));
+        assert_eq!(writer.scalar_writes, 1);
+        assert_eq!(writer.flushes, usize::from(!fail_write));
+        assert_eq!(
+            writer.bytes.as_slice(),
+            if fail_write { &b""[..] } else { &b"reply"[..] }
+        );
+        assert!(batch.delivered.is_empty());
+        assert_eq!(batch.payload_bytes, 0);
+        assert_eq!(
+            recv_stream.next_offset(),
+            5,
+            "local errors do not revoke receipt facts"
+        );
+    }
