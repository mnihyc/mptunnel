diff --git a/src/runtime/relay/io.rs b/src/runtime/relay/io.rs
index 2d71940..7c40339 100644
--- a/src/runtime/relay/io.rs
+++ b/src/runtime/relay/io.rs
@@ -911,6 +911,83 @@ pub(in crate::runtime) async fn write_applied_ready_stream_data_batch<S, T>(
     batch: &mut ReadyStreamDataBatch<T>,
     applied: ReadyStreamDataBatchApplyState,
 ) -> Result<usize, RuntimeError>
+where
+    S: AsyncWrite + Unpin,
+{
+    #[cfg(feature = "lab-diagnostics")]
+    {
+        use std::future::Future;
+        use std::task::Poll;
+
+        let direction = applied.direction;
+        let offered_bytes = batch
+            .delivered
+            .iter()
+            .map(Bytes::len)
+            .fold(0usize, usize::saturating_add);
+        let write = write_applied_ready_stream_data_batch_inner(local, batch, applied);
+        tokio::pin!(write);
+        let mut first_poll = true;
+        return std::future::poll_fn(|cx| {
+            if !first_poll {
+                return write.as_mut().poll(cx);
+            }
+            first_poll = false;
+            let started = Instant::now();
+            let result = write.as_mut().poll(cx);
+            let elapsed = started.elapsed();
+            let component = match (direction, offered_bytes > 0, &result) {
+                (ReadyStreamDataDirection::ClientDownload, true, Poll::Ready(Ok(_))) => {
+                    "relay.local_write_first_poll.client_download.nonempty.ready_ok"
+                }
+                (ReadyStreamDataDirection::ClientDownload, true, Poll::Ready(Err(_))) => {
+                    "relay.local_write_first_poll.client_download.nonempty.ready_err"
+                }
+                (ReadyStreamDataDirection::ClientDownload, true, Poll::Pending) => {
+                    "relay.local_write_first_poll.client_download.nonempty.pending"
+                }
+                (ReadyStreamDataDirection::ClientDownload, false, Poll::Ready(Ok(_))) => {
+                    "relay.local_write_first_poll.client_download.empty.ready_ok"
+                }
+                (ReadyStreamDataDirection::ClientDownload, false, Poll::Ready(Err(_))) => {
+                    "relay.local_write_first_poll.client_download.empty.ready_err"
+                }
+                (ReadyStreamDataDirection::ClientDownload, false, Poll::Pending) => {
+                    "relay.local_write_first_poll.client_download.empty.pending"
+                }
+                (ReadyStreamDataDirection::ServerUpload, true, Poll::Ready(Ok(_))) => {
+                    "relay.local_write_first_poll.server_upload.nonempty.ready_ok"
+                }
+                (ReadyStreamDataDirection::ServerUpload, true, Poll::Ready(Err(_))) => {
+                    "relay.local_write_first_poll.server_upload.nonempty.ready_err"
+                }
+                (ReadyStreamDataDirection::ServerUpload, true, Poll::Pending) => {
+                    "relay.local_write_first_poll.server_upload.nonempty.pending"
+                }
+                (ReadyStreamDataDirection::ServerUpload, false, Poll::Ready(Ok(_))) => {
+                    "relay.local_write_first_poll.server_upload.empty.ready_ok"
+                }
+                (ReadyStreamDataDirection::ServerUpload, false, Poll::Ready(Err(_))) => {
+                    "relay.local_write_first_poll.server_upload.empty.ready_err"
+                }
+                (ReadyStreamDataDirection::ServerUpload, false, Poll::Pending) => {
+                    "relay.local_write_first_poll.server_upload.empty.pending"
+                }
+            };
+            crate::lab_diagnostics::lab_perf_record(component, elapsed, offered_bytes);
+            result
+        })
+        .await;
+    }
+    #[cfg(not(feature = "lab-diagnostics"))]
+    write_applied_ready_stream_data_batch_inner(local, batch, applied).await
+}
+
+async fn write_applied_ready_stream_data_batch_inner<S, T>(
+    local: &mut S,
+    batch: &mut ReadyStreamDataBatch<T>,
+    applied: ReadyStreamDataBatchApplyState,
+) -> Result<usize, RuntimeError>
 where
     S: AsyncWrite + Unpin,
 {
