+#[test]
+fn joint_feedback_acceptance_fences_one_chunk_without_gating_credit() {
+    let stream_id = StreamId(7);
+    let (binding, initial, mut receivers) = binding_for_underlay(UnderlayProtocol::Tcp);
+    let commands = with_output_entry_for_key(&binding, initial, |entry| entry.commands.clone());
+    for nonce in 0..8 {
+        commands
+            .try_enqueue_admitted_frame(Frame::Ping { nonce }, TrafficClass::Control)
+            .unwrap();
+    }
+    let chunks = vec![
+        Frame::StreamAck {
+            stream_id,
+            scope_start: None,
+            ranges: vec![OffsetRange { start: 0, end: 8 }],
+        },
+        Frame::StreamAck {
+            stream_id,
+            scope_start: Some(8),
+            ranges: vec![OffsetRange { start: 16, end: 24 }],
+        },
+    ];
+    let (ack, max) = binding.publish_ack_with_max_data(stream_id, 1, &chunks, &chunks, Some(4096));
+    assert!(!ack.accepted && !ack.published && ack.pending);
+    assert_eq!(max.published_offset, None);
+    assert!(max.pending);
+    assert_eq!(
+        with_output_entry_for_key(&binding, initial, |entry| entry.published_max_data_offset),
+        0
+    );
+    let held = try_recv_reliable_path_priority_command(&mut receivers).unwrap();
+    receivers.release_pending_command_bytes(reliable_path_command_pending_bytes(&held));
+
+    let (ack, max) = binding.retry_pending_ack_with_max_data(stream_id, 1, &chunks, Some(4096));
+    assert!(ack.accepted && !ack.published && ack.pending);
+    assert_eq!(max.published_offset, Some(4096));
+    assert!(!max.pending);
+    for nonce in 1..8 {
+        let held = try_recv_reliable_path_priority_command(&mut receivers).unwrap();
+        receivers.release_pending_command_bytes(reliable_path_command_pending_bytes(&held));
+        assert!(
+            matches!(held, ReliablePathCommand::SendFrame(Frame::Ping { nonce: received }) if received == nonce)
+        );
+    }
+    let held = try_recv_reliable_path_priority_command(&mut receivers).unwrap();
+    assert_eq!(reliable_path_command_pending_bytes(&held), 2);
+    receivers.release_pending_command_bytes(2);
+    match held {
+        ReliablePathCommand::SendFeedbackPair(pair) => assert_eq!(
+            pair.into_frames(),
+            [
+                chunks[0].clone(),
+                Frame::StreamMaxData {
+                    stream_id,
+                    max_offset: 4096
+                }
+            ]
+        ),
+        _ => panic!("accepted prefix and grant share one queue transaction"),
+    }
+    assert!(binding.retry_pending_ack(1, &chunks).published);
+    let held = try_recv_reliable_path_priority_command(&mut receivers).unwrap();
+    receivers.release_pending_command_bytes(reliable_path_command_pending_bytes(&held));
+    assert!(matches!(held, ReliablePathCommand::SendFrame(frame) if frame == chunks[1]));
+
+    let (ack, max) = binding.retry_pending_ack_with_max_data(stream_id, 1, &chunks, Some(4097));
+    assert!(!ack.accepted && ack.published && !ack.pending);
+    assert_eq!(max.published_offset, Some(4097));
+    assert!(!max.pending, "already covered ACK cannot gate newer credit");
+    let held = try_recv_reliable_path_priority_command(&mut receivers).unwrap();
+    receivers.release_pending_command_bytes(reliable_path_command_pending_bytes(&held));
+    assert!(matches!(
+        held,
+        ReliablePathCommand::SendFrame(Frame::StreamMaxData {
+            max_offset: 4097,
+            ..
+        })
+    ));
+    assert_eq!(commands.pending_bytes(), 0);
+}
