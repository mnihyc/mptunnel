+#[tokio::test]
+async fn client_joint_feedback_fences_partial_ack_and_independent_credit() {
+    let stream_id = StreamId(924);
+    let (commands, mut receivers) = reliable_path_command_channels(1);
+    let (mut remotes, _input) =
+        ReliableRelayRemoteSet::new(opened_test_relay_stream(stream_id, 0, commands.clone()), 4);
+    consume_client_path_proof_for_test(&mut receivers);
+    let grant = remotes.paths[0].published_max_data_offset + 32;
+    let chunks = vec![
+        Frame::StreamAck {
+            stream_id,
+            scope_start: None,
+            ranges: vec![OffsetRange { start: 0, end: 8 }],
+        },
+        Frame::StreamAck {
+            stream_id,
+            scope_start: Some(8),
+            ranges: vec![OffsetRange { start: 16, end: 24 }],
+        },
+    ];
+    commands
+        .try_enqueue_admitted_frame(Frame::Ping { nonce: 1 }, TrafficClass::Control)
+        .unwrap();
+    let (ack, max) =
+        remotes.publish_stream_ack_with_max_data(1, chunks.clone(), chunks.clone(), Some(grant));
+    assert!(!ack.accepted && !ack.published && ack.pending);
+    assert_eq!(max.published_offset, None);
+    assert!(max.pending);
+    let held = try_recv_reliable_path_priority_command(&mut receivers).unwrap();
+    receivers.release_pending_command_bytes(reliable_path_command_pending_bytes(&held));
+    assert!(matches!(
+        held,
+        ReliablePathCommand::SendFrame(Frame::Ping { nonce: 1 })
+    ));
+
+    let (ack, max) = remotes.retry_pending_stream_ack_with_max_data(Some(grant));
+    assert!(ack.accepted && !ack.published && ack.pending);
+    assert_eq!(max.published_offset, Some(grant));
+    assert!(
+        !max.pending,
+        "credit does not wait for the complete ACK generation"
+    );
+    let held = try_recv_reliable_path_priority_command(&mut receivers).unwrap();
+    assert_eq!(reliable_path_command_pending_bytes(&held), 2);
+    receivers.release_pending_command_bytes(2);
+    match held {
+        ReliablePathCommand::SendFeedbackPair(pair) => assert_eq!(
+            pair.into_frames(),
+            [
+                chunks[0].clone(),
+                Frame::StreamMaxData {
+                    stream_id,
+                    max_offset: grant
+                }
+            ]
+        ),
+        _ => panic!("first accepted chunk carries the independent grant"),
+    }
+    assert!(remotes.retry_pending_stream_ack().published);
+    let held = try_recv_reliable_path_priority_command(&mut receivers).unwrap();
+    receivers.release_pending_command_bytes(reliable_path_command_pending_bytes(&held));
+    assert!(matches!(held, ReliablePathCommand::SendFrame(frame) if frame == chunks[1]));
+
+    let (ack, max) = remotes.retry_pending_stream_ack_with_max_data(Some(grant + 1));
+    assert!(!ack.accepted && ack.published && !ack.pending);
+    assert_eq!(max.published_offset, Some(grant + 1));
+    assert!(!max.pending);
+    let held = try_recv_reliable_path_priority_command(&mut receivers).unwrap();
+    receivers.release_pending_command_bytes(reliable_path_command_pending_bytes(&held));
+    assert!(
+        matches!(held, ReliablePathCommand::SendFrame(Frame::StreamMaxData { max_offset, .. }) if max_offset == grant + 1)
+    );
+    assert_eq!(commands.pending_bytes(), 0);
+
+    let (replacement_commands, mut replacement_rx) = reliable_path_command_channels(4);
+    remotes.attach(opened_test_relay_stream(stream_id, 1, replacement_commands));
+    consume_client_path_proof_for_test(&mut replacement_rx);
+    let (ack, max) = remotes.retry_pending_stream_ack_with_max_data(Some(grant + 1));
+    assert!(ack.accepted && ack.published && !ack.pending);
+    assert_eq!(max.published_offset, Some(grant + 1));
+    assert!(!max.pending);
+    let held = try_recv_reliable_path_priority_command(&mut replacement_rx).unwrap();
+    replacement_rx.release_pending_command_bytes(reliable_path_command_pending_bytes(&held));
+    assert!(matches!(held, ReliablePathCommand::SendFeedbackPair(_)));
+    let held = try_recv_reliable_path_priority_command(&mut replacement_rx).unwrap();
+    replacement_rx.release_pending_command_bytes(reliable_path_command_pending_bytes(&held));
+    assert!(matches!(held, ReliablePathCommand::SendFrame(frame) if frame == chunks[1]));
+    assert!(try_recv_reliable_path_priority_command(&mut receivers).is_none());
+}
