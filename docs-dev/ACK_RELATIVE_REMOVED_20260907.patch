@@ -0,0 +1,151 @@
+//! Lossless ACK dictionary scoped to one reliable ordered native direction.
+//! Product always receives the original full Frame, never a relative vector.
+
+use super::*;
+use crate::protocol::frame::{normalize_offset_ranges, offset_ranges_not_covered};
+use std::sync::Arc;
+
+#[derive(Debug)]
+struct AckBasis {
+    stream_id: StreamId,
+    ranges: Vec<OffsetRange>,
+}
+
+fn canonical(ranges: &[OffsetRange]) -> bool {
+    ranges.iter().all(|range| !range.is_empty())
+        && ranges.windows(2).all(|pair| pair[0].end < pair[1].start)
+}
+
+fn basis(frame: &Frame) -> Option<Arc<AckBasis>> {
+    match frame {
+        Frame::StreamAck {
+            stream_id,
+            complete: true,
+            ranges,
+        } if canonical(ranges) => Some(Arc::new(AckBasis {
+            stream_id: *stream_id,
+            ranges: ranges.clone(),
+        })),
+        _ => None,
+    }
+}
+
+fn ack_range_wire_bytes(ranges: &[OffsetRange]) -> usize {
+    let fixed = ranges.len() * 16;
+    packed_ack_ranges_len(ranges).map_or(fixed, |packed| packed.min(fixed))
+}
+
+#[derive(Debug, Clone, Default)]
+pub(crate) struct FrameEncoder {
+    // One vector, not a logical-stream map. Switching complete ACK identity
+    // trades a full frame for bounded lifetime memory.
+    basis: Option<Arc<AckBasis>>,
+}
+
+impl FrameEncoder {
+    /// The caller encodes into a prospective clone, clears its live encoder
+    /// before awaited native writes, and installs the clone only on success.
+    pub(crate) fn encode_frame_into(
+        &mut self,
+        frame: &Frame,
+        limits: CodecLimits,
+        out: &mut Vec<u8>,
+    ) -> Result<(), CodecError> {
+        if let Frame::StreamAck { ranges, .. } = frame {
+            if ranges.len() > limits.max_ack_ranges {
+                return Err(CodecError::TooManyAckRanges {
+                    actual: ranges.len(),
+                    limit: limits.max_ack_ranges,
+                });
+            }
+            if ranges.len() > usize::from(u16::MAX) {
+                return Err(CodecError::LengthOverflow);
+            }
+        }
+        let next_basis = basis(frame);
+        if let (Some(previous), Some(next)) = (&self.basis, &next_basis)
+            && previous.stream_id == next.stream_id
+            && next.ranges.len() <= limits.max_ack_ranges
+            && next.ranges.len() <= usize::from(u16::MAX)
+            && offset_ranges_not_covered(&previous.ranges, &next.ranges).is_empty()
+        {
+            let additions = offset_ranges_not_covered(&next.ranges, &previous.ranges);
+            if additions.len() <= limits.max_ack_ranges
+                && additions.len() <= usize::from(u16::MAX)
+                && ack_range_wire_bytes(&additions) < ack_range_wire_bytes(&next.ranges)
+            {
+                let start = out.len();
+                encode_frame_into(
+                    &Frame::StreamAck {
+                        stream_id: next.stream_id,
+                        complete: true,
+                        ranges: additions,
+                    },
+                    limits,
+                    out,
+                )?;
+                out[start + FRAME_HEADER_LEN + 8] |= 4;
+                self.basis = next_basis;
+                return Ok(());
+            }
+        }
+        encode_frame_into(frame, limits, out)?;
+        if matches!(frame, Frame::StreamAck { complete: true, .. }) {
+            self.basis = next_basis;
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct FrameDecoder {
+    basis: Option<Arc<AckBasis>>,
+}
+
+impl FrameDecoder {
+    pub(crate) fn decode_frame_bytes(
+        &mut self,
+        bytes: Bytes,
+        limits: CodecLimits,
+    ) -> Result<Frame, CodecError> {
+        let (kind, mut reader) = frame_reader(&bytes, limits)?;
+        if kind != FrameKind::StreamAck {
+            let frame = decode_payload(kind, limits, &mut reader)?;
+            reader.finish()?;
+            return Ok(frame);
+        }
+        let (mut frame, relative) = decode_ack_payload(&mut reader, limits, true)?;
+        reader.finish()?;
+        if relative {
+            let Frame::StreamAck {
+                stream_id, ranges, ..
+            } = &mut frame
+            else {
+                unreachable!()
+            };
+            let previous = self
+                .basis
+                .as_ref()
+                .filter(|previous| previous.stream_id == *stream_id)
+                .ok_or(CodecError::MissingAckBasis)?;
+            if !canonical(ranges) || offset_ranges_not_covered(ranges, &previous.ranges) != *ranges
+            {
+                return Err(CodecError::InvalidRange);
+            }
+            let mut combined = previous.ranges.clone();
+            combined.append(ranges);
+            let combined = normalize_offset_ranges(combined);
+            if combined.len() > limits.max_ack_ranges || combined.len() > usize::from(u16::MAX) {
+                return Err(CodecError::TooManyAckRanges {
+                    actual: combined.len(),
+                    limit: limits.max_ack_ranges.min(usize::from(u16::MAX)),
+                });
+            }
+            *ranges = combined;
+        }
+        if matches!(frame, Frame::StreamAck { complete: true, .. }) {
+            self.basis = basis(&frame);
+        }
+        Ok(frame)
+    }
+}
