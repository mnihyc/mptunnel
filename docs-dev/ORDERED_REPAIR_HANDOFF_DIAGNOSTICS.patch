+#[cfg(feature = "lab-diagnostics")]
+fn lab_quic_frame_handoff(
+    frames: &[Frame],
+    native_stream_id: quinn::StreamId,
+    phase: &str,
+    elapsed_us: u128,
+) {
+    if !crate::lab_diagnostics::lab_diagnostic_event_enabled("quic_frame_handoff") {
+        return;
+    }
+    for frame in frames {
+        if let Frame::StreamData {
+            stream_id,
+            offset,
+            payload,
+        } = frame
+        {
+            crate::lab_diagnostics::lab_diagnostic(
+                "quic_frame_handoff",
+                format_args!(
+                    "stream_id={} native_stream_id={:?} phase={} offset={} end={} payload_bytes={} elapsed_us={}",
+                    stream_id.0,
+                    native_stream_id,
+                    phase,
+                    offset,
+                    offset.saturating_add(payload.len() as u64),
+                    payload.len(),
+                    elapsed_us,
+                ),
+            );
+        }
+    }
+}
