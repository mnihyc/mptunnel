+#[test]
+fn request_rate_refreshes_during_continuous_pipelining() {
+    let started = Instant::now();
+    let bytes = PATH_OPEN_SCORE_BYTES as u64;
+    let mut evidence = RequestPathRateEvidence::new(started);
+
+    for index in 0..4 {
+        let sent_at = started + Duration::from_millis(index * 50);
+        let acked_at = sent_at + Duration::from_millis(100);
+        let update = evidence.observe(bytes, sent_at, sent_at, acked_at, bytes);
+        let RequestPathRateEvidenceUpdate::Proven {
+            sample: Some(sample),
+            first_window,
+        } = update
+        else {
+            panic!("chronological pipelined cohort {index} must refresh exact receipt service");
+        };
+        assert_eq!(first_window, index == 0);
+        assert_eq!(sample.bytes(), bytes);
+        assert_eq!(
+            sample.elapsed(),
+            Duration::from_millis(if index == 0 { 100 } else { 50 }),
+        );
+    }
+}
