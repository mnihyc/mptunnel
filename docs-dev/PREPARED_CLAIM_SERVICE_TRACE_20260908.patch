+/// Temporary claim-service observation. Counts cover every enabled occurrence;
+/// fields are a sampled actual state, not a reconstruction of intervening
+/// states. One-second reporting follows the existing diagnostic cadence and
+/// never gates Product work. Keys are process-local stream/physical identities
+/// for this bounded single-session capture, not a new global identity model.
+pub(crate) fn lab_counted_diagnostic(
+    event: &'static str,
+    stream_id: u64,
+    path_instance_id: u64,
+    stage: &'static str,
+    fields: impl FnOnce() -> String,
+) {
+    if !lab_diagnostic_event_enabled(event) {
+        return;
+    }
+    type Key = (&'static str, u64, u64, &'static str);
+    struct Count {
+        count: u64,
+        first_ms: u128,
+        last_ms: u128,
+        next_report: Instant,
+    }
+    static COUNTS: OnceLock<Mutex<HashMap<Key, Count>>> = OnceLock::new();
+    let now = Instant::now();
+    let unix_ms = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis();
+    let sample = {
+        let mut counts = COUNTS
+            .get_or_init(Default::default)
+            .lock()
+            .expect("lab claim counts");
+        let value = counts
+            .entry((event, stream_id, path_instance_id, stage))
+            .or_insert(Count {
+                count: 0,
+                first_ms: unix_ms,
+                last_ms: unix_ms,
+                next_report: now,
+            });
+        value.count = value.count.saturating_add(1);
+        value.first_ms = value.first_ms.min(unix_ms);
+        value.last_ms = value.last_ms.max(unix_ms);
+        if now < value.next_report {
+            None
+        } else {
+            value.next_report = now + Duration::from_secs(1);
+            Some((value.count, value.first_ms, value.last_ms))
+        }
+    };
+    // Neither caller state formatting nor output executes under the aggregate
+    // mutex. Busy callers supply no new Product snapshot or Native read.
+    if let Some((count, first_ms, last_ms)) = sample {
+        lab_diagnostic(
+            event,
+            format_args!(
+                "stream_id={} path_instance_id={} stage={} count={} first_unix_ms={} last_unix_ms={} {}",
+                stream_id,
+                path_instance_id,
+                stage,
+                count,
+                first_ms,
+                last_ms,
+                fields(),
+            ),
+        );
+    }
+}
+
