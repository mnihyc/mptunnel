+        complete: true,
+        ranges: next_ranges,
+    };
+    for (mut client, mut server) in [
+        connected_pair(4096).await,
+        transport_secret_pair(4096).await,
+    ] {
+        let (sent, received) = tokio::join!(client.write_frame(&base), server.read_frame());
+        sent.unwrap();
+        assert_eq!(received.unwrap(), base);
+        let (_, mut writer) = client.split().unwrap();
+        let (mut reader, _) = server.split().unwrap();
+        let (sent, received) = tokio::join!(writer.write_frame(&next), reader.read_frame());
+        sent.unwrap();
+        assert_eq!(received.unwrap(), next);
+        assert!(
+            writer.wire_bytes_written() < 256,
+            "splitting discarded the compression basis"
+        );
+    }
+}
