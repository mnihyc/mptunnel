+// Temporary synchronous-owner profiling. Nested scopes overlap and must not
+// be summed as independent CPU time; no scheduler or feedback authority.
+pub(crate) struct LabPerfScope(&'static str, Instant);
+
+impl LabPerfScope {
+    pub(crate) fn new(component: &'static str) -> Self {
+        Self(component, Instant::now())
+    }
+}
+
+impl Drop for LabPerfScope {
+    fn drop(&mut self) {
+        lab_perf_record(self.0, self.1.elapsed(), 0);
+    }
+}
