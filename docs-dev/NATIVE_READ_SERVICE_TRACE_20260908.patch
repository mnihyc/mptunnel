+// Temporary native-read observer. All state is diagnostic-only, under the
+// existing connection guard. A canceled read future has no callback here:
+// availability-to-return therefore includes caller scheduling/pauses, and an
+// episode without a return remains censored rather than a proved network wait.
+#[cfg(feature = "lab-diagnostics")]
+#[derive(Debug, Clone, Copy)]
+struct NativeReadStamp {
+    at: std::time::Instant,
+    unix_ms: u128,
+    mono_us: u128,
+}
+
+#[cfg(feature = "lab-diagnostics")]
+impl NativeReadStamp {
+    fn now() -> Self {
+        static EPOCH: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+        let epoch = *EPOCH.get_or_init(std::time::Instant::now);
+        let at = std::time::Instant::now();
+        Self {
+            at,
+            unix_ms: std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_millis(),
+            mono_us: at.saturating_duration_since(epoch).as_micros(),
+        }
+    }
+}
+
+#[cfg(feature = "lab-diagnostics")]
+#[derive(Debug)]
+struct NativeReadEpisode {
+    connection_id: usize,
+    stream_id: StreamId,
+    ordinal: u64,
+    read_offset: u64,
+    started: NativeReadStamp,
+    available: Option<NativeReadStamp>,
+}
+
+#[cfg(feature = "lab-diagnostics")]
+impl NativeReadEpisode {
+    fn emit(&self, phase: &str, stamp: NativeReadStamp, range: Option<(u64, u64)>) {
+        static SEQUENCE: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+        let seq = SEQUENCE.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        // native_seq/native_mono_us have their own process-local observer
+        // domain. Unix stamps join the existing Product log; native offsets
+        // include H3 framing and must never be treated as Product DSNs.
+        eprintln!(
+            "mptunnel_lab_diag ts_unix_ms={} native_mono_us={} native_seq={} pid={} role=server event=native_read_episode phase={} native_connection_id={} native_request_stream_id={} episode={} read_offset={} started_unix_ms={} started_native_mono_us={} available_present={} available_unix_ms={} available_native_mono_us={} range_present={} native_start={} native_end={} elapsed_us={} available_elapsed_us={}",
+            stamp.unix_ms, stamp.mono_us, seq, std::process::id(), phase,
+            self.connection_id, u64::from(self.stream_id), self.ordinal, self.read_offset,
+            self.started.unix_ms, self.started.mono_us,
+            self.available.is_some(), self.available.map_or(0, |s| s.unix_ms),
+            self.available.map_or(0, |s| s.mono_us), range.is_some(),
+            range.map_or(0, |r| r.0), range.map_or(0, |r| r.1),
+            stamp.at.saturating_duration_since(self.started.at).as_micros(),
+            self.available.map_or(0, |s| stamp.at.saturating_duration_since(s.at).as_micros()),
+        );
+    }
+}
+
+#[cfg(feature = "lab-diagnostics")]
+fn native_read_diagnostic_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        let enabled = std::env::var("MPTUNNEL_LAB_DIAG").is_ok_and(|value| {
+            value == "1" || value.eq_ignore_ascii_case("true") || value.eq_ignore_ascii_case("yes")
+        });
+        let selected = std::env::var("MPTUNNEL_LAB_DIAG_EVENTS").map_or(true, |value| {
+            let mut events = value
+                .split(',')
+                .map(str::trim)
+                .filter(|event| !event.is_empty())
+                .peekable();
+            events.peek().is_none()
+                || events.any(|event| event == "*" || event == "native_read_episode")
+        });
+        enabled && selected && std::env::var("MPTUNNEL_LAB_ROLE").as_deref() == Ok("server")
+    })
+}
